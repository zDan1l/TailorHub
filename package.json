{
  "name": "tailorhub",
  "version": "0.1.0",
  "private": true,
  "description": "TailorHub — SaaS manajemen pesanan jahit & konveksi (Cloudflare Pages + Functions + D1)",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy .",
    "db:create": "wrangler d1 create tailorhub",
    "db:init": "wrangler d1 execute tailorhub --local --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute tailorhub --local --file=./db/seed.sql",
    "db:reset": "wrangler d1 execute tailorhub --local --file=./db/schema.sql && wrangler d1 execute tailorhub --local --file=./db/seed.sql",
    "db:init:remote": "wrangler d1 execute tailorhub --remote --file=./db/schema.sql",
    "db:seed:remote": "wrangler d1 execute tailorhub --remote --file=./db/seed.sql",
    "db:console": "wrangler d1 execute tailorhub --local --command"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
